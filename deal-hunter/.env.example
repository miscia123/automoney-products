# Notifiche Telegram: crea un bot con @BotFather, poi scrivi al bot e leggi il chat id
# da https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Perito AI (facoltativo ma consigliato): chiave da https://console.anthropic.com
ANTHROPIC_API_KEY=

# eBay Browse API (facoltativo): chiavi gratuite da https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Proxy residenziale italiano (facoltativo): serve solo se giri su un server in datacenter
# DEALHUNTER_PROXY=http://user:pass@host:port

# Email (facoltativo): smtps://utente:password@smtp.gmail.com:465
# DEALHUNTER_SMTP_URL=
# DEALHUNTER_EMAIL_TO=
